{
  "name": "pagespeed-auditor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "prisma migrate dev && prisma generate && echo \"\n  Schema changed — RESTART the dev server; it caches the generated client.\n\"",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "throughput-dryrun": "tsx scripts/throughput-dryrun.ts",
    "inspect-sitemap": "tsx scripts/inspect-sitemap.ts",
    "ingest": "tsx scripts/ingest.ts",
    "verify:ingest": "tsx scripts/verify-ingest-invariants.ts",
    "verify:audit": "tsx scripts/verify-audit-path.ts",
    "audit:group": "tsx scripts/audit-group.ts",
    "audit:queue": "tsx scripts/queue-audit.ts",
    "canary": "tsx scripts/canary.ts",
    "env": "tsx scripts/set-env.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "verify:tenants": "tsx scripts/verify-tenant-isolation.ts",
    "db:migrate:tenant": "prisma migrate dev --config prisma/tenant/prisma.config.ts && npm run build:tenant-migrations",
    "build:tenant-migrations": "tsx scripts/build-tenant-migrations.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@workflow/core": "^5.0.0-beta.43",
    "@workflow/next": "^5.0.0-beta.43",
    "agentation": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "cron-parser": "^5.10.0",
    "fast-xml-parser": "^5.11.0",
    "jose": "^6.2.9",
    "mcp-handler": "^2.1.1",
    "next": "16.1.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.20.0",
    "workflow": "^5.0.0-beta.43",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "@swc/core@1.15.3": true,
    "cbor-extract@2.2.2": true
  }
}

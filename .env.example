# ── Core ────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────
# Matches docker-compose.dev.yml. Prisma reads .env (NOT .env.local).
DATABASE_URL=postgresql://psa:psa@localhost:5432/pagespeed_auditor?schema=public

# No Redis: the PSI rate limiter and the scheduler heartbeat both moved to
# Postgres (docs/DECISIONS.md #16) once BullMQ -- the one thing that
# actually needed Redis's blocking commands -- was already gone.

# ── Blob storage ────────────────────────────────────────
# Where AuditResult.rawJson lives for new rows instead of Postgres -- see
# docs/DECISIONS.md §13. Provisioned via the Vercel dashboard's Storage tab
# (or `vercel integration add`), then `vercel env pull`. Note: for this
# project specifically, `vercel env pull` returns BLOB_READ_WRITE_TOKEN
# empty even in production -- see the same gotcha in CLAUDE.md for
# DATABASE_URL. There is no local dev fallback for it; it can only be
# exercised against a real Vercel deployment.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Concurrency must sit ABOVE what the limiter needs, not below.
# Little's Law: in-flight = rate x latency.
#
# Measured against the REAL site, not a test page: www.zuddl.com takes ~60s per
# PSI call (light pages like example.com take 11-24s). So 0.75 req/s x 60s = 45
# in flight, and 48 gives headroom.
#
# Raising this does NOT hit PSI harder -- the Postgres-backed token bucket
# caps the actual request rate regardless. It only allows more calls to be
# waiting at once.
# Setting it too LOW is the silent failure: at 20 the ceiling is 20/60 = 0.33
# req/s and a sweep takes 75 minutes instead of 33, with no error anywhere.
WORKER_CONCURRENCY=48

# 3 requests per 4000 ms = 0.75 req/s sustained.
PSI_RATE_MAX=3
PSI_RATE_WINDOW_MS=4000

# How long a run can sit at 'running'/'queued' with no progress before the
# cron tick treats it as abandoned and reconciles it (run.service.ts). Not a
# queue lock -- there is no queue anymore, retries live inside one Workflow
# step (docs/DECISIONS.md §11).
STALE_RUN_HOURS=12

# ── PageSpeed Insights ──────────────────────────────────
# Optional fallback only. Each site carries its own key, set by an admin under
# Settings -> Site, so tenants do not share a Google quota. This is used when a
# site has none of its own -- handy for a single-tenant install.
# The keyless endpoint returns 429 (its shared quota is permanently exhausted),
# so SOME key is always required.
# Get one: https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=
PSI_TIMEOUT_MS=90000
PSI_MAX_ATTEMPTS=5
# 1 = serve committed fixtures with simulated latency (tests / throughput dry-run)
PSI_FAKE=0

# ── Site under audit ────────────────────────────────────
SITE_NAME="Company Site"
SITE_BASE_URL=https://www.example.com
SITE_SITEMAP_URL=https://www.example.com/sitemap.xml
# Group audits at or above this page count run async instead of synchronously.
SYNC_GROUP_PAGE_LIMIT=15

# ── Auth ────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=30

# ── Retention ───────────────────────────────────────────
# rawJson is 300 KB-1.2 MB per response; unpruned this is ~500 GB/year.
# Audit results kept per page and strategy (~2 months of weekly checks).
# A run's results, markdown and AI recommendation are kept and removed together.
RESULT_RETAIN_RUNS=10

# ── Stage 3+ (not yet implemented) ──────────────────────
# EMAIL_TRANSPORT=none
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PageSpeed Auditor <noreply@example.com>"
# SLACK_WEBHOOK_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
MCP_BEARER_TOKEN=            # openssl rand -hex 24; unset disables /api/mcp entirely

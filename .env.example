# ── Core ────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────
# Matches docker-compose.dev.yml. Prisma reads .env (NOT .env.local).
DATABASE_URL=postgresql://psa:psa@localhost:5432/pagespeed_auditor?schema=public

# No Redis: the PSI rate limiter and the scheduler heartbeat both moved to
# Postgres (docs/DECISIONS.md #16) once BullMQ -- the one thing that
# actually needed Redis's blocking commands -- was already gone.

# Local-dev-only, for authoring prisma/tenant/schema.prisma migrations --
# see docs/DECISIONS.md §19. Never used at runtime; a real tenant database's
# connection string is decrypted per-organisation instead. Create it with:
#   docker exec pagespeed-auditor-postgres-1 psql -U psa -d postgres -c "CREATE DATABASE pagespeed_auditor_tenant_dev;"
# then: npm run db:migrate:tenant
# TENANT_DEV_DATABASE_URL=postgresql://psa:psa@localhost:5432/pagespeed_auditor_tenant_dev?schema=public

# ── Raw JSON storage ────────────────────────────────────
# Where AuditResult.rawJson lives for new rows instead of Postgres -- see
# docs/DECISIONS.md §18 (§13 for why it left Postgres at all, §16 for the
# Vercel Blob attempt in between that this replaced). A Cloudflare D1
# database, called over its plain HTTP query API -- no Cloudflare Workers
# runtime involved, and unlike Vercel Blob, this CAN be exercised from
# local dev, since it's just an authenticated fetch() to api.cloudflare.com.
#
# CLOUDFLARE_ACCOUNT_ID: `wrangler whoami`, or the Cloudflare dashboard URL
#   (dash.cloudflare.com/<account-id>/...).
# CLOUDFLARE_D1_DATABASE_ID: `wrangler d1 create <name>` prints it, or
#   `wrangler d1 list`.
# CLOUDFLARE_API_TOKEN: dash.cloudflare.com/profile/api-tokens -> Create
#   Token -> Custom Token -> permission "D1: Edit", scoped to this account.
#   Not the `wrangler login` OAuth token -- that's short-lived and tied to
#   an interactive session, not meant to be embedded anywhere.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Concurrency must sit ABOVE what the limiter needs, not below.
# Little's Law: in-flight = rate x latency.
#
# Measured against the REAL site, not a test page: www.zuddl.com takes ~60s per
# PSI call (light pages like example.com take 11-24s). So 0.75 req/s x 60s = 45
# in flight, and 48 gives headroom.
#
# Raising this does NOT hit PSI harder -- the Postgres-backed token bucket
# caps the actual request rate regardless. It only allows more calls to be
# waiting at once.
# Setting it too LOW is the silent failure: at 20 the ceiling is 20/60 = 0.33
# req/s and a sweep takes 75 minutes instead of 33, with no error anywhere.
WORKER_CONCURRENCY=48

# 3 requests per 4000 ms = 0.75 req/s sustained.
PSI_RATE_MAX=3
PSI_RATE_WINDOW_MS=4000

# How long a run can sit at 'running'/'queued' with no progress before the
# cron tick treats it as abandoned and reconciles it (run.service.ts). Not a
# queue lock -- there is no queue anymore, retries live inside one Workflow
# step (docs/DECISIONS.md §11).
STALE_RUN_HOURS=12

# ── PageSpeed Insights ──────────────────────────────────
# Optional fallback only. Each site carries its own key, set by an admin under
# Settings -> Site, so tenants do not share a Google quota. This is used when a
# site has none of its own -- handy for a single-tenant install.
# The keyless endpoint returns 429 (its shared quota is permanently exhausted),
# so SOME key is always required.
# Get one: https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=
PSI_TIMEOUT_MS=90000
PSI_MAX_ATTEMPTS=5
# 1 = serve committed fixtures with simulated latency (tests / throughput dry-run)
PSI_FAKE=0

# ── Site under audit ────────────────────────────────────
SITE_NAME="Company Site"
SITE_BASE_URL=https://www.example.com
SITE_SITEMAP_URL=https://www.example.com/sitemap.xml
# Group audits at or above this page count run async instead of synchronously.
SYNC_GROUP_PAGE_LIMIT=15

# ── Auth ────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Encrypts secrets too sensitive for a plain column -- a tenant's own Neon
# connection string and Cloudflare D1 credentials (lib/crypto/secretBox.ts),
# once per-tenant databases land. Same generation command as SESSION_SECRET,
# but a DIFFERENT value -- never reuse one secret for two purposes.
SECRET_BOX_KEY=

# Optional: "Continue with Google" alongside password sign-in, on login,
# signup, and accept-invite. Leave both blank and the button just doesn't
# render -- nothing else changes. From a Google Cloud OAuth 2.0 Client ID
# ("Web application" type); add http(s)://<your-app-url>/api/auth/google/callback
# as an authorized redirect URI. GOOGLE_CLIENT_SECRET must stay server-side;
# GOOGLE_CLIENT_ID is fine to be public.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Retention ───────────────────────────────────────────
# rawJson is 300 KB-1.2 MB per response; unpruned this is ~500 GB/year.
# Audit results kept per page and strategy (~2 months of weekly checks).
# A run's results, markdown and AI recommendation are kept and removed together.
RESULT_RETAIN_RUNS=10

# ── Stage 3+ (not yet implemented) ──────────────────────
# EMAIL_TRANSPORT=none
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PageSpeed Auditor <noreply@example.com>"
# SLACK_WEBHOOK_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
MCP_BEARER_TOKEN=            # openssl rand -hex 24; unset disables /api/mcp entirely

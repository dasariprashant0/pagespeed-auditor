// PageSpeed Auditor data model.
//
// Additions to the original build spec are marked "SPEC+" with the reason.
// See docs/PLAN.md -> "Schema changes to the spec's reference model".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// A person. Identity is global; what they can DO comes from Membership.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// Nullable: a Google-only account never sets one. Password sign-in checks
  /// this and fails cleanly (not a bcrypt crash) when it's null -- see
  /// lib/services/account.service.ts's login().
  passwordHash String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  memberships Membership[]
  invitesSent Invitation[] @relation("InvitedBy")
  resetTokens PasswordReset[]
}

/// A single-use password reset.
///
/// Hashed like an invitation, for the same reason: a leaked database row must
/// not be redeemable. Short-lived, because an unused reset link sitting in a
/// mailbox is a standing key to the account.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A tenant. Every Site, Page and AuditResult belongs to exactly one --
/// but lives in THAT organisation's own tenant database (prisma/tenant/schema.prisma),
/// not here. This row only carries identity/membership data plus the
/// encrypted pointer to where the real data actually lives -- see
/// docs/PER_TENANT_ARCHITECTURE.md.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  /// Per-organisation SMTP override, same shape as Site.psiApiKey below --
  /// null means "use the shared SMTP_* env vars." Admin-editable, verified by
  /// a real connection check before saving, never sent to the browser unmasked.
  ///
  /// Deliberately NOT used for password-reset emails: those are looked up by
  /// email address alone, before any organisation is known, and one User can
  /// belong to more than one Organisation (see Membership) -- there is no
  /// single tenant to attribute that email to. Only sends that already have
  /// an organisation in hand at send time (invitations, sweep notifications)
  /// use this. See docs/DECISIONS.md.
  smtpHost String?
  smtpPort Int?
  smtpUser String?
  smtpPass String?
  smtpFrom String?

  /// Per-tenant infrastructure -- see docs/DECISIONS.md §19. Each organisation
  /// brings its own Neon database and its own Cloudflare D1 database instead
  /// of sharing the app owner's. All four secrets are envelope-encrypted
  /// (lib/crypto/secretBox.ts, AES-256-GCM) -- NOT the plain-column
  /// convention smtpPass/Site.psiApiKey use, since a leaked row here is full
  /// read/write access to an external database, not "send email as this
  /// mailbox." Additive only as of this migration: nothing reads or writes
  /// these columns yet.
  tenantDbUrlEnc  String?
  d1AccountIdEnc  String?
  d1DatabaseIdEnc String?
  d1ApiTokenEnc   String?
  /// unprovisioned | provisioning | ready | failed
  provisionStatus String    @default("unprovisioned")
  provisionError  String?
  provisionedAt   DateTime?

  members     Membership[]
  invitations Invitation[]
  mcpTokens   McpToken[]
}

/// An agent's key into ONE organisation.
///
/// A single shared token in an environment variable cannot work once there is
/// more than one tenant: whoever holds it would reach whichever organisation
/// happened to be queried. Tokens are per-organisation, stored hashed, and
/// revocable individually.
model McpToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  tokenHash      String       @unique
  createdById    String?
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId])
}

/// Roles, least to most privileged. Stored as a string rather than a Postgres
/// enum so adding one later is a code change, not a migration with a lock.
///   viewer    - read reports, download the agent markdown
///   editor    - also run audits, generate recommendations, rename/merge groups
///   developer - also the MCP token and raw PSI JSON
///   admin     - also teammates, PSI key, site config, schedule, notifications
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("viewer")
  createdAt      DateTime     @default(now())
  /// Per-membership onboarding progress -- see docs/superpowers/specs/2026-08-22-onboarding-tour-design.md.
  /// Hard-deleted with the row on removal, so remove-then-re-add naturally
  /// restarts onboarding with no special-case code.
  tourStepsSeen        String[]  @default([])
  checklistDismissedAt DateTime?

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// A pending invitation. The token is stored hashed: a leaked database row must
/// not be redeemable.
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("viewer")
  tokenHash      String       @unique
  invitedById    String?
  invitedBy      User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
}

/// Replaces Redis entirely (see docs/DECISIONS.md #16) for a small,
/// infrequent, latency-insensitive job that never needed a separate
/// request-metered service once BullMQ -- the thing that originally
/// justified Redis -- was removed. One fixed-window token bucket, keyed by
/// name. windowStart is the window's own start time in epoch ms, not a
/// TTL -- computed once from wall-clock time, the same value every caller
/// in that window agrees on without needing to ask Redis what it is.
///
/// This table exists in BOTH the central and tenant schemas, for two
/// different buckets -- see docs/DECISIONS.md §19's "side effect" note.
/// An organisation with its own PSI key paces against the "psi" key in
/// ITS OWN tenant database (lib/opsState.ts's getPsiRateLimiter); every
/// organisation still falling back to the shared PSI_API_KEY env var
/// paces against the "psi:shared-fallback" key HERE, in the central
/// database, since that's the one place genuinely shared across all of
/// them. KeyValue (the scheduler heartbeat) and RunLogEvent (the live run
/// terminal) used to also live centrally for the same original reason
/// this comment describes, but both are purely per-organisation state now
/// and only exist in the tenant schema -- removed from here as dead
/// leftovers from before the Phase 5 cutover (docs/PER_TENANT_ARCHITECTURE.md).
model RateLimitBucket {
  key         String @id
  windowStart BigInt
  count       Int
}
